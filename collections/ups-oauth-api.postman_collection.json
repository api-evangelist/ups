  "info": {
    "_postman_id": "c38cbc7f-e082-468c-9361-35a2b94a61f3",
    "name": "UPS Shipping Address Validation OAuth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The UPS Shipping API enables developers to create and manage shipments, generate shipping labels, validate addresses, retrieve rates, track packages, schedule pickups, manage returns, and access time-in-transit information. UPS uses OAuth 2.0 with client credentials for authentication.\n\nContact Support:\n Name: UPS Developer Support",
      "type": "text/plain"
    }
  }
